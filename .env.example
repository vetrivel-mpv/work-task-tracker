# ==============================================================================
# Environment Configuration for Jira-Like Workspace, Hasura GraphQL & PostgreSQL
# ==============================================================================

# Server & Mode
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
POSTGRES_DB_URL=postgres://postgres:postgrespassword@localhost:5432/acm_jira
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=acm_jira

# Hasura GraphQL Engine Configuration
HASURA_GRAPHQL_ENDPOINT=http://localhost:8080/v1/graphql
HASURA_ADMIN_SECRET=adminsecretkey

# Azure DevOps Integration (Optional for live work item enrichment)
ADO_ORG=
ADO_PROJECT=
ADO_PAT=

# Gemini AI QA Assistant (Optional for smart blockers assessment & duplicate scanner)
GEMINI_API_KEY=
